{
  "manifest_version": 3,
  "name": "Stager - Enterprise Command Center",
  "version": "1.0.0",
  "description": "Enterprise launchpad, omnibox go-links resolver, and contextual command center.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms"
  ],
  "omnibox": {
    "keyword": "go"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Stager Side Panel"
  }
}
